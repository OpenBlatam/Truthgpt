# TruthGPT — API keys (copy to .env and fill in your values)
# El loader (utils/internet_search.load_env_manually) lee este archivo automáticamente.

# Semantic Scholar Academic Graph API.
# Obtén tu clave gratuita en: https://www.semanticscholar.org/me/account/manage
# Sin clave funciona, pero el tráfico anónimo se limita (HTTP 429); con clave se elimina el rate-limit.
SEMANTIC_SCHOLAR_API_KEY=

# Tavily web/neural search (opcional, usado por utils/internet_search).
TAVILY_API_KEY=
