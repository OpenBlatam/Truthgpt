# ============================================================================
# 🔐 TruthGPT Cloud — Configuración de Producción para Cobros
# ============================================================================
# INSTRUCCIONES:
# 1. Obtén tus claves en https://dashboard.stripe.com/apikeys
# 2. Para PRUEBAS usa claves que empiecen con sk_test_ y pk_test_
# 3. Para COBROS REALES (dinero real) usa claves sk_live_ y pk_live_
# 4. Configura el webhook en https://dashboard.stripe.com/webhooks
#    - URL del endpoint: https://tu-dominio.com/api/v1/cloud/billing/webhook/stripe
#    - Eventos a escuchar:
#      * checkout.session.completed
#      * customer.subscription.created
#      * customer.subscription.updated
#      * customer.subscription.deleted
#      * invoice.payment_succeeded
#      * invoice.payment_failed
#      * charge.succeeded
#      * charge.failed
# ============================================================================

# Stripe Secret Key (obligatorio para cobrar)
# Formato test: sk_test_xxxxxxxxx
# Formato live: sk_live_xxxxxxxxx
STRIPE_SECRET_KEY=

# Stripe Publishable Key (para el frontend/checkout)
# Formato test: pk_test_xxxxxxxxx
# Formato live: pk_live_xxxxxxxxx
STRIPE_PUBLISHABLE_KEY=

# Stripe Webhook Secret (para validar firma HMAC de webhooks)
# Formato: whsec_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=

# ============================================================================
# 📍 URLs de Retorno (ajusta a tu dominio de producción)
# ============================================================================
TRUTHGPT_BASE_URL=http://localhost:8080
TRUTHGPT_SUCCESS_URL=http://localhost:8080/dashboard?payment=success
TRUTHGPT_CANCEL_URL=http://localhost:8080/dashboard?payment=canceled

# ============================================================================
# 💾 Almacenamiento
# ============================================================================
# Backend: json (default), sqlite
TRUTHGPT_STORAGE_BACKEND=json
# Ruta del archivo de base de datos (se auto-detecta si no se especifica)
# TRUTHGPT_STORAGE_PATH=

# ============================================================================
# 🔒 Seguridad
# ============================================================================
# Secret para firmar JWT de sesiones (genera uno aleatorio en producción)
TRUTHGPT_JWT_SECRET=truthgpt-cloud-jwt-secret-change-me-in-production
# Entorno de prueba (poner 0 en producción)
TRUTHGPT_TEST_ENV=0
